  "cards": [
    {
      "dot": "rose",
      "title": "The decision",
      "items": [
        "Accepting and notifying are separate",
        "The API answers once the row and the message exist",
        "A broken notifier loses nothing: messages wait"
      ]
    },
    {
      "dot": "cyan",
      "title": "Each tier admits only the one in front",
      "items": [
        "alb → app on 8080, by security-group reference",
        "app → db on 5432; the database has no egress rule",
        "The instance has no public IP"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the alarms watch",
      "items": [
        "NotificationsFailed > 0 for 1 minute (custom metric)",
        "DLQ not empty (AWS/SQS metric; fires in AWS, not locally)",
        "One trace id across both log groups"
      ]
    }

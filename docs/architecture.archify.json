    "title": "order-lab: accept now, notify later",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "request",
        "label": "The request",
        "focus": [
          "client",
          "alb",
          "app",
          "rds",
          "sqs"
        ],
        "note": "POST /orders is done once the row is in Postgres and the message is on the queue. The customer never waits for the notification."
      },
      {
        "id": "async",
        "label": "The notification",
        "focus": [
          "sqs",
          "lambda",
          "dlq"
        ],
        "note": "Lambda pulls from the queue through an event source mapping. Three failures and SQS moves the message to the DLQ."
      },
      {
        "id": "observe",
        "label": "Observability",
        "focus": [
          "app",
          "lambda",
          "cloudwatch"
        ],
        "note": "JSON logs with a trace id from both sides via the awslogs driver and Lambda; custom metrics; two alarms."
      }
    ]
  },
